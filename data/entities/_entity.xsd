<?xml version="1.0"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="https://open-champ.com/mySchema"
    elementFormDefault="qualified"
> 

<xs:element name="entity">
    <xs:complexType>
        <xs:all>
            <!-- Movement component for anything that can move (with or without pathfinding) -->
            <xs:element name="movement" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:attribute name="move_speed" type="xs:float" use="optional" />
                </xs:complexType>
            </xs:element>
            
            <!-- Entities with this component will use the navigation mesh to pathfind their way across the map -->
            <xs:element name="pathfinding" minOccurs="0" maxOccurs="1">
            </xs:element>

            <!-- Only entities with a network component will be synchronized to clients -->
            <xs:element name="network" minOccurs="0" maxOccurs="1" />

            <!-- This is, like, a required component? For the entity state machine? TODO ploinky 17/11/2025 -->
            <xs:element name="state" minOccurs="0" maxOccurs="1" />

            <!-- Entities with this component will have NPC behavior according to the type -->
            <xs:element name="npc" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:attribute name="type" type="xs:string" use="required" />
                    <xs:attribute name="chase_distance" type="xs:float" use="optional" />
                    <xs:attribute name="chase_timeout_ms" type="xs:float" use="optional" />
                </xs:complexType>
            </xs:element>

            <!-- Auto-attack component enables AI entities to automatically search for and attack targets -->
            <xs:element name="auto_attack" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:attribute name="enabled" type="xs:boolean" use="optional" />
                    <xs:attribute name="aggressive" type="xs:boolean" use="optional" />
                    <xs:attribute name="retaliate_only" type="xs:boolean" use="optional" />
                    <xs:attribute name="aggression_range" type="xs:float" use="optional" />
                    <xs:attribute name="retreat_range" type="xs:float" use="optional" />
                    <xs:attribute name="personality" type="xs:string" use="optional" />
                    <xs:attribute name="combat_timeout_ms" type="xs:float" use="optional" />
                    <xs:attribute name="base_damage_multiplier" type="xs:float" use="optional" />
                    <xs:attribute name="bonus_damage" type="xs:float" use="optional" />
                    <xs:attribute name="attack_animation_duration_ms" type="xs:float" use="optional" />
                    <xs:attribute name="hit_timing_percent" type="xs:float" use="optional" />
                    <xs:attribute name="allow_kiting" type="xs:boolean" use="optional" />
                </xs:complexType>
            </xs:element>

            <!-- Target component for tracking current attack target -->
            <xs:element name="target" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:attribute name="targeting_mode" type="xs:string" use="optional" />
                    <xs:attribute name="search_cooldown_ms" type="xs:float" use="optional" />
                </xs:complexType>
            </xs:element>

            <!-- Attack component for tracking attack state and cooldowns -->
            <xs:element name="attack" minOccurs="0" maxOccurs="1">
            </xs:element>

            <!-- All unit stats, should probably be split up (HealthComponent, MovementComponent, LevelComponent) -->
            <xs:element name="stats" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <!-- Core Stats -->
                    <xs:attribute name="max_health" type="xs:float" use="optional" />
                    <xs:attribute name="health" type="xs:float" use="optional" />
                    <xs:attribute name="max_mana" type="xs:float" use="optional" />
                    <xs:attribute name="mana" type="xs:float" use="optional" />
                    <xs:attribute name="move_speed" type="xs:float" use="optional" />
                    <xs:attribute name="required_exp" type="xs:float" use="optional" />
                    <xs:attribute name="addition_exp_per_level" type="xs:float" use="optional" />
                    <xs:attribute name="current_exp" type="xs:float" use="optional" />
                    <xs:attribute name="level" type="xs:int" use="optional" />

                    <!-- Offensive Stats -->
                    <xs:attribute name="attack_range" type="xs:float" use="optional" />
                    <xs:attribute name="attack_speed" type="xs:float" use="optional" />
                    <xs:attribute name="crit_chance" type="xs:float" use="optional" />
                    <xs:attribute name="crit_bonus" type="xs:int" use="optional" />
                    <xs:attribute name="true_bonus" type="xs:int" use="optional" />
                    <xs:attribute name="magic_power" type="xs:float" use="optional" />
                    <xs:attribute name="physical_power" type="xs:float" use="optional" />
                    <xs:attribute name="projectile_speed" type="xs:float" use="optional" />

                    <!-- Defensive Stats -->
                    <xs:attribute name="armor" type="xs:int" use="optional" />
                    <xs:attribute name="magic_resist" type="xs:int" use="optional" />
                    <xs:attribute name="dodge" type="xs:int" use="optional" />

                    <!-- Offensive Stats -->
                    <xs:attribute name="health_regen" type="xs:float" use="optional" />
                    <xs:attribute name="mana_regen" type="xs:float" use="optional" />
                    <xs:attribute name="life_steal" type="xs:float" use="optional" />
                    <xs:attribute name="spell_vamp" type="xs:float" use="optional" />
                    <xs:attribute name="omni_vamp" type="xs:float" use="optional" />
                    <xs:attribute name="leech" type="xs:float" use="optional" />
                    <xs:attribute name="vision_range" type="xs:float" use="optional" />

                    <!-- Team Stats -->
                    <xs:attribute name="team_id" type="xs:int" use="optional" />
                </xs:complexType>
            </xs:element>
        </xs:all>
        
        <!-- Uniquely identifies this entity type in the engine. Should be recognizable and probably match the file name -->
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
</xs:element>

</xs:schema>